# --- LLM (server-side only) ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6     # any model id your provider offers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.6
CORS_ORIGINS=http://localhost:5173

# --- Database & auth ---
DATABASE_URL=postgresql+asyncpg://noviqo:noviqo@localhost:5432/noviqo   # omit for a local SQLite file
COOKIE_SECURE=false      # set true behind HTTPS
APP_URL=http://localhost:5173

# Web search (https://tavily.com) - optional; search tool reports "not configured" without it
TAVILY_API_KEY=

# Signs confirmation tokens. Set a long random value in production (required when running multiple workers).
SECRET_KEY=

# --- Email (optional; any SMTP provider with STARTTLS on port 587). Without it, emails are logged, not sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Google Calendar (optional). Create an OAuth "Web application" client in Google Cloud Console, enable the Calendar API,
# --- and add GOOGLE_REDIRECT_URI as an authorised redirect URI. Without these, the calendar tools are hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/callback

# --- Production (docker compose) ---
DOMAIN=localhost                 # your domain; Caddy gets a Let's Encrypt certificate automatically
POSTGRES_PASSWORD=               # required; also embedded in DATABASE_URL by docker-compose.yml
# ENV=production is set by docker-compose.yml. In production the app refuses to start with a weak or missing
# SECRET_KEY (32+ chars), COOKIE_SECURE != true, a non-PostgreSQL database, or the default DB password.
LOG_LEVEL=INFO
METRICS_TOKEN=                   # enables GET /metrics (Bearer token). Unset = endpoint disabled (404)
SENTRY_DSN=                      # optional error tracking; cookies, headers and bodies are stripped before sending

# --- PC control (for running NOVIQO on your own computer; refused in production). Changes always need your confirmation. ---
ENABLE_COMPUTER_TOOLS=true       # open apps, list/read/create files inside WORKSPACE_DIR
ENABLE_COMMANDS=false            # also let it run shell commands (you read and click Confirm each time). Off unless you choose.
WORKSPACE_DIR=                   # default: your user folder, in a folder called NOVIQO
